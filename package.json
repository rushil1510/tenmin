{
  "name": "tenmin",
  "version": "0.1.0",
  "description": "Order food & groceries from Swiggy without leaving your terminal",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "tenmin": "dist/index.js"
  },
  "scripts": {
    "dev": "tsx src/index.ts",
    "build": "tsup src/index.ts --format esm --out-dir dist --clean --shims",
    "postbuild": "chmod +x dist/index.js",
    "start": "node dist/index.js",
    "lint": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "keywords": [
    "swiggy",
    "cli",
    "food-ordering",
    "mcp",
    "developer-tools",
    "instamart"
  ],
  "author": "Rushil Mital <rushilmital003@gmail.com>",
  "license": "MIT",
  "dependencies": {
    "@inquirer/prompts": "^7.0.0",
    "@langchain/core": "^1.1.44",
    "@langchain/google-genai": "^2.1.30",
    "@langchain/langgraph": "^1.2.9",
    "chalk": "^5.4.0",
    "commander": "^13.0.0",
    "langchain": "^1.3.5",
    "ora": "^8.0.0",
    "zod": "^4.4.2"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsup": "^8.0.0",
    "tsx": "^4.0.0",
    "typescript": "^5.7.0",
    "vitest": "^4.1.5"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
